---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoIsland from '../../islands/VideoIsland.jsx';
import { VIDEOS } from '../../data/site.js';
import {
  VIDEO_THUMBNAIL_FALLBACK,
  youtubeThumbnailCandidates,
} from '../../utils/videoThumbnails.js';
import {
  assertValidVideoMetadata,
  durationToIso8601,
} from '../../utils/videoMetadata.js';

export async function getStaticPaths() {
  return VIDEOS.map((video) => {
    assertValidVideoMetadata(video);

    return {
      params: { id: video.id },
      props: { video },
    };
  });
}

const { id } = Astro.params;
const { video } = Astro.props;

const description = video?.description?.slice(0, 200) ?? '';
const lang = video?.lang === 'es' ? 'es' : 'en';
const image = new URL(VIDEO_THUMBNAIL_FALLBACK, Astro.site).toString();
const thumbnailUrls = youtubeThumbnailCandidates(video).map((candidate) =>
  new URL(candidate, Astro.site).toString()
);

const jsonLd = video ? {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: video.title,
  description,
  thumbnailUrl: thumbnailUrls,
  uploadDate: video.uploadDate,
  embedUrl: `https://www.youtube-nocookie.com/embed/${id}`,
  ...(video.duration ? { duration: durationToIso8601(video.duration) } : {}),
  inLanguage: lang,
} : undefined;
---
<BaseLayout
  title={video?.title ?? id}
  description={description}
  image={image}
  type="article"
  lang={lang as 'en' | 'es'}
  jsonLd={jsonLd}
>
  <VideoIsland id={id} client:load />
</BaseLayout>
